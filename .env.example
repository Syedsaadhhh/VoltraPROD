# Sound Rehearsal Environment Configuration
# Copy this file to .env in the repository root and fill in your real credentials.
# Never commit real credentials, keys, or passwords to git or logs.

# ==============================================================================
# 1. Google AI Studio / Gemini Developer API
# ==============================================================================
# Obtain an API key from https://aistudio.google.com/
# Free-tier Developer API key. Do not use Vertex AI or paid billing for this hackathon track.
GOOGLE_API_KEY=

# Default Gemini model ID. Recommended free-tier models: gemini-2.5-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# 2. ClickHouse Cloud Connection
# ==============================================================================
# ClickHouse Cloud host (e.g., your-instance.region.azure.clickhouse.cloud)
CLICKHOUSE_HOST=

# Native HTTPS / TLS port for ClickHouse Cloud (default 8443)
CLICKHOUSE_PORT=8443

# ClickHouse user with read/select permissions for MCP queries
CLICKHOUSE_USER=default

# ClickHouse user password
CLICKHOUSE_PASSWORD=

# ClickHouse database name for sound rehearsal catalog
CLICKHOUSE_DATABASE=default

# Enable TLS/SSL connection (true for ClickHouse Cloud)
CLICKHOUSE_SECURE=true

# Verify SSL certificates (true recommended)
CLICKHOUSE_VERIFY=true

# Keep MCP access read-only (false prevents accidental table mutation through MCP)
CLICKHOUSE_ALLOW_WRITE_ACCESS=false

# Connection timeout in seconds
CLICKHOUSE_CONNECT_TIMEOUT=30

# Optional writer credential for admin seeding scripts only (separate from MCP read user)
CLICKHOUSE_ADMIN_USER=
CLICKHOUSE_ADMIN_PASSWORD=

# ==============================================================================
# 3. Firebase / Firestore (Spark Free Plan)
# ==============================================================================
# Dedicated Firebase project ID.
# IMPORTANT: Do not use or modify an existing Firebase project belonging to another app.
FIREBASE_PROJECT_ID=

# Option A: Path to service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option B: Direct service account fields (recommended for containerized / Render environments)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==============================================================================
# 4. Web Application Server & Environment
# ==============================================================================
# Hosting port (Render injects PORT automatically; defaults to 8000 locally)
PORT=8000

# Environment mode: development or production
ENVIRONMENT=development

# Frontend base URL for CORS (comma-separated if multiple)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
