# VoltraPROD environment configuration
# Copy this file to .env in the repository root and fill in your own credentials.
# Never commit real credentials, private keys, or passwords.

# ==============================================================================
# 1. Gemini / Google AI
# ==============================================================================
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# 2. ClickHouse Cloud
# ==============================================================================
# Use the hostname only, without https:// or a path.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_ALLOW_WRITE_ACCESS=false
CLICKHOUSE_CONNECT_TIMEOUT=30

# Optional credentials used only for catalog seeding / event writes when available.
# The runtime MCP connection remains read-only.
CLICKHOUSE_ADMIN_USER=
CLICKHOUSE_ADMIN_PASSWORD=

# ==============================================================================
# 3. Firebase / Firestore
# ==============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=

# Optional. The hosted deployment currently provides this value in render.yaml.
FIREBASE_APP_ID=

# Alternative to the direct service-account fields above:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ==============================================================================
# 4. Web server
# ==============================================================================
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
